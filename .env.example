# Copy to .env for local development:  cp .env.example .env
# Never commit .env — it is git-ignored.

# --- Database ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=recruitops
DB_PORT=5432

# --- JWT signing key (REQUIRED, >= 32 characters) ---
# Development value only. Production uses a secret store, never this file.
JWT_KEY=dev-only-signing-key-change-me-at-least-32-chars

# --- First Administrator (creates the company and its first Admin) ---
# Development: created whenever this email is not yet a user.
# Any other environment: used ONLY while the database has no users at all (first run), needs a
# password of 12+ characters, and is ignored with a warning afterwards. Remove both once the
# install is up — they are no longer needed, and a secret should not outlive its purpose.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# --- Object storage (MinIO locally, Cloudflare R2 in hosted installs) ---
MINIO_USER=minioadmin
MINIO_PASSWORD=minioadmin

# --- Host ports ---
API_PORT=5080
WEB_PORT=3000

# Internal SPA host port
INTERNAL_PORT=5173
