# Copy to .env for local development:  cp .env.example .env
# Never commit .env — it is git-ignored.

# --- Database ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=recruitops
DB_PORT=5432

# --- JWT signing key (REQUIRED, >= 32 bytes) ---
# Development value only: in any other environment the API refuses to start with it, because
# anyone who has read this file could mint tokens. Generate one per install, e.g.
#   openssl rand -base64 48
JWT_KEY=dev-only-signing-key-change-me-at-least-32-chars

# --- First Administrator (creates the company and its first Admin) ---
# Development: created whenever this email is not yet a user.
# Any other environment: used ONLY while the database has no users at all (first run), needs a
# password of 12+ characters, and is ignored with a warning afterwards. Remove both once the
# install is up — they are no longer needed, and a secret should not outlive its purpose.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# --- Object storage (MinIO locally, Cloudflare R2 in hosted installs) ---
# The CV bucket is private (ADR-0029): CVs are served only through the API, never from storage.
MINIO_USER=minioadmin
MINIO_PASSWORD=minioadmin
# The password of the API's own storage account, `recruitops-api` (docker-compose.prod.yml): it
# reaches the CV bucket only. 12+ characters, not the root password. Applied on every start —
# changing it and running `up -d` is how the credential is rotated or revoked.
MINIO_APP_PASSWORD=

# --- TLS (docker-compose.prod.yml only; the dev file serves plain HTTP on localhost) ---
# A directory holding fullchain.pem + privkey.pem. Required in production — the stack refuses to
# start without it. How to get one: docs/architecture/deployment-runbook.md, section 0b.
# TLS_CERT_DIR=/etc/recruitops/tls
# Where `certbot renew --webroot` writes Let's Encrypt challenges (default ./infra/acme).
# ACME_WEBROOT=/var/www/recruitops-acme

# --- What sits in front of the proxy (docker-compose.prod.yml) ---
# none (default) | cloudflare | cloudflare-tunnel — how nginx finds the visitor's real address, which
# the login rate limit and the audit log depend on. docs/architecture/cloudflare-integration-guide.md
# EDGE_PROXY=none
# Only with EDGE_PROXY=cloudflare-tunnel and `--profile cloudflare-tunnel`:
# CLOUDFLARE_TUNNEL_TOKEN=

# --- Host ports ---
API_PORT=5080
WEB_PORT=3000

# Internal SPA host port
INTERNAL_PORT=5173
