{
  "name": "recruitops",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*",
    "frontend/internal",
    "frontend/public"
  ],
  "scripts": {
    "dev:internal": "npm run dev --workspace @recruitops/internal",
    "dev:public": "npm run dev --workspace @recruitops/public",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  }
}
