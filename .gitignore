# Node / Vite / Next.js
# Paths are unanchored on purpose: ADR-0012 split one app at `frontend/` into
# `frontend/internal` + `frontend/public`, so `frontend/.next/` alone stopped matching.
node_modules/
.next/
out/
dist/
next-env.d.ts
*.tsbuildinfo
.vite/

# Env & secrets  (NEVER commit real tokens — see .mcp.json note in README)
.env
.env.*
!.env.example
*.local.json
infra/secrets/

# IDE / OS
.vs/
.idea/
.DS_Store
Thumbs.db

# Office lock/owner files — created while a .docx/.xlsx is open, and they carry
# the editing user's name. Never useful in history.
~$*
