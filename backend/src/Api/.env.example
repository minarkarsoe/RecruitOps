# Copy real values into user-secrets or environment — do NOT commit them.
#   dotnet user-secrets set "Jwt:Key" "<long random string, >= 32 bytes>"
#   dotnet user-secrets set "Seed:AdminEmail" "admin@youragency.com"
#   dotnet user-secrets set "Seed:AdminPassword" "<a strong password>"
ConnectionStrings__Default=Host=localhost;Port=5432;Database=recruitops;Username=postgres;Password=postgres
Jwt__Key=CHANGE_ME_use_a_long_random_secret_at_least_32_bytes
# Optional dev seed (creates one tenant + admin on Development startup if both are set):
Seed__AdminEmail=
Seed__AdminPassword=
